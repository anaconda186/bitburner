    "esbuild": "0.28.2",
    "lodash": "4.17.23",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yauzl": "3.4.0"
  },
  "version": "1.0.0",
  "description": "My scripts for [Bitburner](https://github.com/bitburner-official/bitburner-src).",
