{
  "name": "bitburner-speedrun",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fetch-game": "node tools/fetch-game.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "ram-check": "node tools/ram-check.ts",
    "publish-release": "node tools/publish.ts"
  },
