{
  // Game scripts: src/ compiles to build/, which mirrors home (boot.js at the
  // root, everything else under sr/). Browser globals only, no Node types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": [],
    "rootDir": "./src",
    "outDir": "./build",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
